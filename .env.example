# Copy this file to .env and fill it in. .env is git-ignored and never committed.
# `make secrets` turns these values into the Kubernetes Secret
# "echomind-api-keys", which n8n imports its credentials from.

# OpenAI-compatible LLM endpoint key (default endpoint: Hack Club AI,
# https://ai.hackclub.com/proxy/v1 - change llm.baseUrl in the Helm values
# to use another provider)
LLM_API_KEY=

# Hugging Face token (read access) for sentence-transformers/all-MiniLM-L6-v2 embeddings
HUGGINGFACE_API_KEY=

# Shared secrets that protect EchoMind's own endpoints (any long random strings,
# e.g. `openssl rand -hex 24`)
ECHOMIND_INGEST_TOKEN=
ECHOMIND_RECALL_PASSWORD=
